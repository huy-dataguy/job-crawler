[Unit]
Description=Vietnam Job Crawler Dashboard (localhost:8130)
After=network-online.target

[Service]
WorkingDirectory=@REPO_DIR@
ExecStart="@REPO_DIR@/.venv/bin/python" -m uvicorn dashboard.main:app --host 127.0.0.1 --port 8130
Restart=on-failure
RestartSec=5
Nice=5

[Install]
WantedBy=default.target
